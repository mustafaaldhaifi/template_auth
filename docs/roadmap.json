                                "name": "ip_id",
                                "type": "bigint",
                                "nullable": false,
                                "references": {
                                    "table": "ips",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "last_seen_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ],
                        "constraints": [
                            "PRIMARY KEY (device_id, ip_id)"
