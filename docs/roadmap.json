                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "last_seen_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ]
