                },
                {
                    "id": "create-ip-devices-table",
                    "title": "Link each observed IP address to each device and track when the link was created and last seen",
                    "version": "0.3.4",
                    "type": "backend",
                    "changeType": "add",
                    "done": false,
                    "verification": "Apply the migration and confirm one device can use several IPs, one IP can serve several devices, and duplicate pairs are rejected.",
                    "structure": {
                        "table": "ip_devices",
                        "operation": "create",
                        "columns": [
