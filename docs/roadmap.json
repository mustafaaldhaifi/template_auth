                {
                    "id": "email-recovery-code-api",
                    "title": "Replace emailed reset links with eight-digit codes, add POST /api/auth/verify-reset-code, and allow password reset only after code verification without limiting code-entry attempts",
                    "version": "0.2.3",
                    "type": "backend",
                    "changeType": "update",
                    "done": true,
                    "verification": "A registered address receives an eight-digit code instead of a link; wrong, expired, and reused codes fail; a verified code permits one password change, with no code-entry attempt limit.",
                    "structure": {
                        "table": "password_reset_tokens",
                        "operation": "alter",
                        "migration": "Add the two columns and mark existing unused link tokens as consumed while preserving their rows.",
                        "columns": [
                            {
                                "name": "token_hash",
                                "type": "text",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "expires_at",
                                "type": "timestamptz",
                                "nullable": false
                            },
                            {
                                "name": "consumed_at",
                                "type": "timestamptz",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "code_salt",
                                "type": "text",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "verified_token_hash",
                                "type": "text",
                                "nullable": true,
                                "default": null,
                                "unique": true
                            }
                        ],
                        "constraints": [
                            "length(token_hash) = 64",
                            "expires_at > created_at",
                            "code_salt IS NULL OR code_salt ~ '^[0-9a-f]{32}$'",
                            "verified_token_hash IS NULL OR length(verified_token_hash) = 64",
                            "NOT (code_salt IS NOT NULL AND verified_token_hash IS NOT NULL)"
                        ],
                        "indexes": [
                            {
                                "columns": ["user_id", "created_at DESC"]
                            }
                        ]
                    }
                },
                {
                    "id": "connect-recovery-flow",
                    "title": "Connect /forgot-password, /verify-reset-code, and /reset-password to the email-code APIs, then navigate to /login for manual sign-in after the password changes",
                    "version": "0.2.4",
                    "type": "frontend",
                    "changeType": "update",
                    "done": true,
                    "verification": "On web, Android, and iOS, a registered user receives a code, verifies it, changes the password, then signs in manually with the new password; invalid and expired codes show errors without limiting entry attempts."
