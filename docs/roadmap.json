                    }
                },
                {
                    "id": "create-auth-sessions-table",
                    "title": "Create persistent sessions with an internal ID, linked users and devices, issuing IP, expiry, and revocation timestamps",
                    "version": "0.3.5",
                    "type": "backend",
                    "changeType": "add",
                    "done": false,
                    "verification": "Apply the migration and confirm a session gets an internal increasing ID, requires an existing user and device, rejects duplicate token hashes, and records its expiry and optional issuing IP.",
                    "structure": {
                        "table": "auth_sessions",
                        "operation": "create",
                        "columns": [
                            {
                                "name": "id",
                                "type": "bigint",
                                "nullable": false,
                                "primaryKey": true,
                                "identity": "generated always"
                            },
                            {
                                "name": "token_hash",
                                "type": "text",
                                "nullable": false,
                                "unique": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "device_id",
                                "type": "bigint",
                                "nullable": false,
                                "references": {
                                    "table": "devices",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "login_ip_id",
                                "type": "bigint",
                                "nullable": true,
                                "references": {
                                    "table": "ips",
                                    "column": "id",
                                    "onDelete": "set null"
