                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "expires_at",
                                "type": "timestamptz",
                                "nullable": false
                            },
                            {
                                "name": "revoked_at",
                                "type": "timestamptz",
                                "nullable": true
                            }
