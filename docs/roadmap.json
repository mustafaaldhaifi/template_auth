                {
                    "id": "persist-device-bound-login-sessions",
                    "title": "Issue server-generated device and session tokens in secure cookies after successful login, persist their hashes, check the device-session match on protected requests, and revoke sessions on logout and password reset using existing routes",
                    "version": "0.3.7",
                    "type": "backend",
                    "changeType": "update",
                    "done": false,
                    "verification": "On web, Android, and iOS, sign in and restart the server: the session remains valid for the same device. Missing or mismatched device cookies return the user to login; logout and password reset invalidate sessions. Verify IP changes alone do not end the session."
                },
                {
                    "id": "enforce-security-blocks",
                    "title": "Check active IP and device blocks on existing authentication and protected requests, revoke a blocked device's sessions, and revoke a selected session without adding public management routes",
                    "version": "0.3.8",
                    "type": "backend",
                    "changeType": "update",
                    "done": false,
                    "verification": "Record a temporary IP block in the development database and confirm requests are rejected until it expires or is lifted. Block a device and confirm its sessions stop while other devices remain signed in. Revoke one session and confirm only that session ends."
                },
                {
                    "id": "connect-device-metadata-on-login",
                    "title": "Send platform and available OS version and model through the shared login API client, and retain both server-issued cookies across app restarts on web, Android, and iOS",
                    "version": "0.3.9",
                    "type": "frontend",
                    "changeType": "update",
                    "done": false,
                    "verification": "On web, Android, and iOS, sign in, restart the app or browser and the server, and confirm the same account remains signed in. Check that an unavailable web hardware model is omitted and that logout requires a new login."
                }
            ]
        }
    ]
}
