        {
            "version": "0.3.0",
            "title": "Recover an account with an eight-digit email code",
            "status": "completed",
            "tasks": [
                {
                    "id": "shared-recovery-code-screen",
                    "title": "Build /verify-reset-code with a reusable channel-independent eight-digit code entry interface and prepare /forgot-password for code recovery without sending the legacy reset link",
                    "version": "0.2.1",
                    "type": "frontend",
                    "changeType": "add",
                    "done": true,
                    "verification": "On web, Android, and iOS, the shared code interface renders, accepts eight digits, and shows local validation; this UI task does not send an email yet."
                },
                {
                    "id": "reset-password-screen",
                    "title": "Build /reset-password with new-password and confirmation fields, local validation, and shared authentication styling",
                    "version": "0.2.2",
                    "type": "frontend",
                    "changeType": "add",
                    "done": true,
                    "verification": "On web, Android, and iOS, the password form renders and validates its fields; saving waits for the backend and final integration tasks."
                },
                {
                    "id": "email-recovery-code-api",
                    "title": "Replace emailed reset links with eight-digit codes, add POST /api/auth/verify-reset-code, and allow password reset only after code verification without limiting code-entry attempts",
                    "version": "0.2.3",
                    "type": "backend",
                    "changeType": "update",
                    "done": true,
                    "verification": "A registered address receives an eight-digit code instead of a link; wrong, expired, and reused codes fail; a verified code permits one password change, with no code-entry attempt limit.",
                    "structure": {
                        "table": "password_reset_tokens",
                        "operation": "alter",
                        "migration": "Add the two columns and mark existing unused link tokens as consumed while preserving their rows.",
                        "columns": [
                            {
                                "name": "token_hash",
                                "type": "text",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "expires_at",
                                "type": "timestamptz",
                                "nullable": false
                            },
                            {
                                "name": "consumed_at",
                                "type": "timestamptz",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "code_salt",
                                "type": "text",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "verified_token_hash",
                                "type": "text",
                                "nullable": true,
                                "default": null,
                                "unique": true
                            }
                        ],
                        "constraints": [
                            "length(token_hash) = 64",
                            "expires_at > created_at",
                            "code_salt IS NULL OR code_salt ~ '^[0-9a-f]{32}$'",
                            "verified_token_hash IS NULL OR length(verified_token_hash) = 64",
                            "NOT (code_salt IS NOT NULL AND verified_token_hash IS NOT NULL)"
                        ],
                        "indexes": [
                            {
                                "columns": ["user_id", "created_at DESC"]
                            }
                        ]
                    }
                },
                {
                    "id": "connect-recovery-flow",
                    "title": "Connect /forgot-password, /verify-reset-code, and /reset-password to the email-code APIs, then navigate to /login for manual sign-in after the password changes",
                    "version": "0.2.4",
                    "type": "frontend",
                    "changeType": "update",
                    "done": true,
                    "verification": "On web, Android, and iOS, a registered user receives a code, verifies it, changes the password, then signs in manually with the new password; invalid and expired codes show errors without limiting entry attempts."
                }
            ]
        },
        {
            "version": "0.4.0",
            "title": "Create device, platform, IP, session, and security-block tables and enforce device-bound sessions",
            "status": "in_progress",
            "tasks": [
                {
                    "id": "create-platforms-table",
                    "title": "Create and seed the platforms lookup table with ios, android, and web",
                    "version": "0.3.1",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "verification": "Apply the migration and confirm that platforms contains exactly the seeded ios, android, and web codes; duplicate or other codes are rejected.",
                    "structure": {
                        "table": "platforms",
                        "operation": "create",
                        "columns": [
                            {
                                "name": "id",
