                    "type": "backend",
                    "changeType": "add",
                    "done": false,
                    "verification": "Apply the migration and confirm a block targets exactly one existing IP, device, or session; invalid target combinations and empty reasons are rejected. Confirm expiry and revocation timestamps can be recorded.",
                    "structure": {
                        "table": "security_blocks",
                        "operation": "create",
