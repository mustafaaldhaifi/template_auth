                {
                    "id": "create-devices-table",
                    "title": "Create devices with an internal increasing ID, a hashed server-issued device token, platform, OS version, and model",
                    "version": "0.3.2",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "verification": "Apply the migration and confirm a device references a seeded platform; duplicate token hashes and unknown platforms are rejected.",
                    "structure": {
                        "table": "devices",
                        "operation": "create",
                        "columns": [
                            {
