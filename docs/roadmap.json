                        "indexes": [
                            {
                                "columns": ["platform_id"]
                            }
                        ]
                    }
                },
                {
                    "id": "create-ips-table",
                    "title": "Create a unique IP address record with creation and last-seen timestamps",
                    "version": "0.3.3",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "verification": "Apply the migration and confirm that an IPv4 or IPv6 address can be recorded once, while a duplicate address is rejected.",
                    "structure": {
                        "table": "ips",
                        "operation": "create",
                        "columns": [
                            {
                                "name": "id",
                                "type": "bigint",
                                "nullable": false,
                                "primaryKey": true,
                                "identity": "generated always"
                            },
                            {
