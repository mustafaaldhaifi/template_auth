        {
            "version": "0.2.0",
            "title": "Connect all account screens to the backend",
            "status": "completed",
            "tasks": [
                {
                    "id": "create-users-table",
                    "title": "Create the users table",
                    "version": "0.1.1",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "structure": {
                        "table": "users",
                        "columns": [
                            {
                                "name": "id",
                                "type": "uuid",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "first_name",
                                "type": "text",
                                "nullable": false
                            },
                            {
                                "name": "last_name",
                                "type": "text",
                                "nullable": false
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ]
                    }
                },
                {
                    "id": "create-user-emails-table",
                    "title": "Create the user_emails table",
                    "version": "0.1.2",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "structure": {
                        "table": "user_emails",
                        "columns": [
                            {
                                "name": "id",
                                "type": "uuid",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id"
                                }
                            },
                            {
                                "name": "email",
                                "type": "text",
                                "nullable": false,
                                "unique": true
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ]
                    }
                },
                {
                    "id": "create-user-passwords-table",
                    "title": "Create the table for password credentials",
                    "version": "0.1.3",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "structure": {
                        "table": "user_passwords",
                        "columns": [
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "primaryKey": true,
                                "references": {
                                    "table": "users",
                                    "column": "id"
                                }
                            },
                            {
                                "name": "password_hash",
                                "type": "text",
                                "nullable": false
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ]
                    }
                },
                {
                    "id": "create-signup-endpoint",
                    "title": "Add POST /api/auth/signup to validate input and create the user, email, and password credential in one transaction",
                    "version": "0.1.4",
                    "type": "backend",
                    "changeType": "add",
                    "done": true
                },
                {
                    "id": "connect-signup-form",
                    "title": "Connect /signup to the sign-up API, submit first and last names separately, and display success and error messages",
                    "version": "0.1.5",
                    "type": "frontend",
                    "changeType": "update",
                    "done": true
                },
                {
                    "id": "create-login-logout-endpoints",
                    "title": "Add login and logout endpoints, connect /login to the login API with errors and dashboard navigation, and add logout to /dashboard",
                    "version": "0.1.6",
                    "type": "backend",
                    "changeType": "add",
                    "done": true
                },
                {
                    "id": "create-current-user-endpoint",
                    "title": "Add GET /api/auth/me to return the signed-in user's first name, last name, and email",
                    "version": "0.1.7",
                    "type": "backend",
                    "changeType": "add",
                    "done": true
                },
                {
                    "id": "connect-profile-and-dashboard",
                    "title": "Connect /profile to the current-user API and display the signed-in user's first name, last name, and email; redirect unauthenticated users from /profile and /dashboard to /login; keep /dashboard empty apart from navigation and logout",
                    "version": "0.1.9",
                    "type": "frontend",
                    "changeType": "update",
                    "done": true
                },
                {
                    "id": "create-password-reset-endpoints",
                    "title": "Store one-time password reset tokens, email reset links through configured SMTP, and add POST /api/auth/forgot-password and POST /api/auth/reset-password",
                    "version": "0.1.11",
                    "type": "backend",
                    "changeType": "add",
                    "done": true,
                    "structure": {
                        "table": "password_reset_tokens",
                        "columns": [
                            {
                                "name": "token_hash",
                                "type": "text",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "expires_at",
                                "type": "timestamptz",
                                "nullable": false
                            },
                            {
                                "name": "consumed_at",
                                "type": "timestamptz",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            }
                        ],
                        "constraints": [
                            "length(token_hash) = 64",
                            "expires_at > created_at"
                        ],
                        "indexes": [
                            {
                                "columns": ["user_id", "created_at DESC"]
                            }
                        ]
                    }
                },
                {
                    "id": "connect-forgot-password-screen",
                    "title": "Connect /forgot-password to the reset request API and display the result",
                    "version": "0.1.12",
                    "type": "frontend",
                    "changeType": "update",
                    "done": true
                }
            ]
        },
        {
            "version": "0.3.0",
            "title": "Recover an account with an eight-digit email code",
            "status": "in_progress",
            "tasks": [
                {
                    "id": "shared-recovery-code-screen",
                    "title": "Build /verify-reset-code with a reusable channel-independent eight-digit code entry interface and prepare /forgot-password for code recovery without sending the legacy reset link",
                    "version": "0.2.1",
                    "type": "frontend",
                    "changeType": "add",
                    "done": true,
                    "verification": "On web, Android, and iOS, the shared code interface renders, accepts eight digits, and shows local validation; this UI task does not send an email yet."
                },
                {
                    "id": "reset-password-screen",
                    "title": "Build /reset-password with new-password and confirmation fields, local validation, and shared authentication styling",
                    "version": "0.2.2",
                    "type": "frontend",
                    "changeType": "add",
                    "done": false,
                    "verification": "On web, Android, and iOS, the password form renders and validates its fields; saving waits for the backend and final integration tasks."
                },
                {
                    "id": "email-recovery-code-api",
                    "title": "Replace emailed reset links with eight-digit codes, add POST /api/auth/verify-reset-code, and allow password reset only after code verification without limiting code-entry attempts",
                    "version": "0.2.3",
                    "type": "backend",
                    "changeType": "update",
                    "done": false,
                    "verification": "A registered address receives an eight-digit code instead of a link; wrong, expired, and reused codes fail; a verified code permits one password change, with no code-entry attempt limit.",
                    "structure": {
                        "table": "password_reset_tokens",
                        "operation": "alter",
                        "migration": "Add the two columns and mark existing unused link tokens as consumed while preserving their rows.",
                        "columns": [
                            {
                                "name": "token_hash",
                                "type": "text",
                                "nullable": false,
                                "primaryKey": true
                            },
                            {
                                "name": "user_id",
                                "type": "uuid",
                                "nullable": false,
                                "references": {
                                    "table": "users",
                                    "column": "id",
                                    "onDelete": "cascade"
                                }
                            },
                            {
                                "name": "expires_at",
                                "type": "timestamptz",
                                "nullable": false
                            },
                            {
                                "name": "consumed_at",
                                "type": "timestamptz",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "created_at",
                                "type": "timestamptz",
                                "nullable": false,
                                "default": "now()"
                            },
                            {
                                "name": "code_salt",
                                "type": "text",
                                "nullable": true,
                                "default": null
                            },
                            {
                                "name": "verified_token_hash",
                                "type": "text",
                                "nullable": true,
                                "default": null,
                                "unique": true
                            }
                        ],
                        "constraints": [
                            "length(token_hash) = 64",
                            "expires_at > created_at",
                            "code_salt IS NULL OR code_salt ~ '^[0-9a-f]{32}$'",
                            "verified_token_hash IS NULL OR length(verified_token_hash) = 64",
                            "NOT (code_salt IS NOT NULL AND verified_token_hash IS NOT NULL)"
                        ],
                        "indexes": [
                            {
                                "columns": ["user_id", "created_at DESC"]
                            }
                        ]
                    }
                },
                {
                    "id": "connect-recovery-flow",
                    "title": "Connect /forgot-password, /verify-reset-code, and /reset-password to the email-code APIs, then navigate to /login for manual sign-in after the password changes",
                    "version": "0.2.4",
                    "type": "frontend",
                    "changeType": "update",
                    "done": false,
                    "verification": "On web, Android, and iOS, a registered user receives a code, verifies it, changes the password, then signs in manually with the new password; invalid and expired codes show errors without limiting entry attempts."
                }
            ]
        }
    ]
}
