                {
                    "id": "create-user-emails-table",
                    "title": "Create the user_emails table",
                    "version": "0.2.2",
                    "type": "backend",
                    "changeType": "add",
                    "done": false,
                    "structure": {
                        "table": "user_emails",
                        "columns": [
