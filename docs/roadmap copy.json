                },
                {
                    "id": "create-auth-tokens-table",
                    "title": "Create storage for one-time email verification and password reset tokens",
                    "version": "0.4.2",
                    "type": "backend",
                    "changeType": "add",
                    "done": false,
                    "structure": {
                        "table": "auth_tokens",
                        "columns": [
